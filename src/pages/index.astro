---
// src/pages/index.astro
import '../styles/global.css'

import WavyText from '../components/WavyText.astro'
import WiggleText from '../components/WiggleText.astro'
---

<html lang="en">
  <script>
    const door = document.getElementById('door') as HTMLButtonElement;
    const doorTooltip = document.getElementById('doorTooltip') as HTMLBaseElement;

    door.addEventListener('mouseenter', () => {
      doorTooltip.classList.add('visible')
    })
    door.addEventListener('mouseleave', () => {
      doorTooltip.classList.remove('visible')
    })
  </script>

